# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# TrueNAS SCALE / PostgreSQL Environment Variables
# These can be defined in TrueNAS SCALE App Configuration -> Environment Variables
# ==============================================================================
POSTGRES_HOST="192.168.1.100"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_postgres_password"
POSTGRES_DATABASE="postgres"
POSTGRES_SSL="false"

# Alternative TrueNAS-prefixed alias environment variables supported:
# TRUENAS_POSTGRES_HOST="192.168.1.100"
# TRUENAS_POSTGRES_PORT="5432"
# TRUENAS_POSTGRES_USER="postgres"
# TRUENAS_POSTGRES_PASSWORD="your_secure_postgres_password"
# TRUENAS_POSTGRES_DB="postgres"

# ==============================================================================
# TrueNAS Login Credentials, RBAC & Session Security
# ==============================================================================
# Save your App Login Credentials in TrueNAS SCALE -> Environment Variables.
# Updating these variables and restarting automatically updates the IT Admin login.
TRUENAS_ADMIN_USERNAME="it-admin"
TRUENAS_ADMIN_EMAIL="it-admin@truenas.local"
TRUENAS_ADMIN_PASSWORD="ChangeMe_TrueNAS_Admin_2026!"

# Standard aliases also supported:
# IT_ADMIN_USERNAME="it-admin"
# IT_ADMIN_EMAIL="it-admin@truenas.local"
# IT_ADMIN_PASSWORD="ChangeMe_TrueNAS_Admin_2026!"

# Optional: Save a Manager login account in TrueNAS environment variables
# TRUENAS_MANAGER_USERNAME="backup-manager"
# TRUENAS_MANAGER_EMAIL="manager@truenas.local"
# TRUENAS_MANAGER_PASSWORD="ChangeMe_Manager_2026!"

# Optional: Set to "true" on reboot to force-reset IT Admin TOTP MFA enrollment
# TRUENAS_RESET_ADMIN_MFA="false"

# 32+ byte random hex/string secret used to encrypt TOTP secrets & sign CSRF/tokens
SESSION_SECRET="replace-with-long-random-hex-secret"

# Sliding session inactivity timeout in minutes (default: 15)
SESSION_INACTIVITY_MINUTES="15"

# Persistent storage directory for user accounts, TOTP state, and audit logs
AUTH_DATA_DIR="./data"
